<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>GUERRERO DEL TECLADO — EDICIÓN COMBATE</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Teko:wght@400;500;600;700&family=JetBrains+Mono:wght@800&display=swap" rel="stylesheet">
<style>
  /* === Variables de diseño: Estilo Guilty Gear Strive (Brutalismo Claro) === */
  :root {
    --bg: #d9d6cf;
    --bg-light: #f4f1ea;
    --panel: #ffffff;
    --ink: #0a0a0a;
    --ink-soft: #2a2a2a;
    --p1: #00b3ff; /* Cian incandescente */
    --p1-dark: #0077cc;
    --p2: #ff3b30; /* Rojo corte */
    --p2-dark: #b30017;
    --accent: #ffd60a; /* Amarillo alerta */
    --grid: rgba(10, 10, 10, 0.08);
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  html, body {
    width: 100%; height: 100%;
    overflow: hidden;
    font-family: 'Teko', sans-serif;
    color: var(--ink);
    background: var(--bg);
    user-select: none;
    -webkit-user-select: none;
  }

  body {
    background: var(--bg);
    background-image: 
      linear-gradient(var(--grid) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid) 1px, transparent 1px);
    background-size: 40px 40px;
    position: relative;
  }

  #app {
    position: relative;
    width: 100%; height: 100vh;
    z-index: 1;
  }

  .screen {
    position: absolute;
    inset: 0;
    display: none;
    flex-direction: column;
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .screen.active {
    display: flex;
    opacity: 1;
  }

  /* === Menú Principal === */
  #menu {
    align-items: center;
    justify-content: center;
    padding: 20px;
  }

  .menu-content {
    max-width: 900px;
    width: 100%;
    text-align: center;
    position: relative;
    animation: fadeIn 0.8s ease;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: scale(0.98); }
    to { opacity: 1; transform: scale(1); }
  }

  .menu-watermark {
    position: absolute;
    top: -40px; left: 50%;
    transform: translateX(-50%);
    font-family: 'Archivo Black', sans-serif;
    font-size: 220px;
    color: rgba(10,10,10,0.03);
    pointer-events: none;
    white-space: nowrap;
    z-index: -1;
    line-height: 1;
  }

  .title-block {
    display: inline-block;
    border: 4px solid var(--ink);
    background: var(--bg-light);
    padding: 10px 40px;
    box-shadow: 12px 12px 0px var(--p1);
    transform: skew(-5deg);
    margin-bottom: 10px;
  }

  .title-block h1 {
    font-family: 'Archivo Black', sans-serif;
    font-size: clamp(48px, 7vw, 100px);
    line-height: 0.9;
    letter-spacing: -2px;
    transform: skew(5deg);
    text-shadow: 4px 4px 0px var(--p2);
  }

  .subtitle {
    font-family: 'Archivo Black', sans-serif;
    font-size: 22px;
    letter-spacing: 6px;
    margin-bottom: 40px;
    text-transform: uppercase;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
  }

  .subtitle::before, .subtitle::after {
    content: '';
    width: 80px; height: 4px;
    background: var(--ink);
  }

  .instructions {
    background: var(--panel);
    border: 3px solid var(--ink);
    box-shadow: 8px 8px 0px var(--ink);
    padding: 30px;
    text-align: left;
    margin-bottom: 40px;
    position: relative;
    clip-path: polygon(0 0, 100% 0, 100% 85%, 92% 100%, 0 100%);
  }

  .instructions::before {
    content: 'MANUAL DEL JUEGO';
    position: absolute;
    top: -2px; left: -2px;
    background: var(--ink); color: var(--bg-light);
    padding: 6px 18px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    letter-spacing: 1px;
  }

  .instructions ul {
    list-style: none;
    margin-top: 15px;
  }

  .instructions li {
    padding: 8px 0;
    font-size: 20px;
    color: var(--ink-soft);
    display: flex;
    align-items: center;
    gap: 15px;
    border-bottom: 1px dashed rgba(10,10,10,0.1);
  }

  .instructions li:last-child { border-bottom: none; }

  .instructions li::before {
    content: '>>';
    color: var(--p1-dark);
    font-family: 'JetBrains Mono', monospace;
    font-weight: 800;
  }

  .instructions strong {
    background: var(--ink);
    color: var(--accent);
    padding: 0 6px;
    font-family: 'Archivo Black', sans-serif;
    text-transform: uppercase;
    font-size: 18px;
  }

  .difficulty-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 15px;
    margin-bottom: 40px;
  }

  .diff-btn {
    padding: 20px 10px;
    background: var(--bg-light);
    border: 3px solid var(--ink);
    cursor: pointer;
    transition: all 0.15s ease;
    position: relative;
    overflow: hidden;
    box-shadow: 6px 6px 0px var(--ink);
  }

  .diff-btn .diff-label {
    display: block;
    font-family: 'Archivo Black', sans-serif;
    font-size: 24px;
    margin-bottom: 4px;
    line-height: 1;
  }

  .diff-btn .diff-desc {
    display: block;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    color: var(--ink-soft);
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .diff-btn:hover {
    transform: translate(-3px, -3px);
    box-shadow: 9px 9px 0px var(--ink);
  }

  .diff-btn:active {
    transform: translate(3px, 3px);
    box-shadow: 0px 0px 0px var(--ink);
  }

  .diff-btn.selected {
    background: var(--p1);
    color: var(--ink);
    border-color: var(--ink);
  }
  
  .diff-btn.selected .diff-desc {
    color: var(--ink);
  }

  .start-btn {
    padding: 20px 80px;
    background: var(--ink);
    color: var(--accent);
    border: 4px solid var(--ink);
    font-family: 'Archivo Black', sans-serif;
    font-size: 32px;
    letter-spacing: 4px;
    cursor: pointer;
    transition: all 0.2s ease;
    box-shadow: 10px 10px 0px var(--p2);
    text-transform: uppercase;
    clip-path: polygon(5% 0, 100% 0, 95% 100%, 0 100%);
  }

  .start-btn:hover {
    background: var(--p2);
    color: var(--bg-light);
    box-shadow: 10px 10px 0px var(--accent);
    transform: translate(-2px, -2px);
  }

  /* === Pantalla de Juego === */
  #game {
    padding: 15px;
    gap: 15px;
  }

  .hud-top {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 20px;
    align-items: center;
    padding: 0;
  }

  .hp-container {
    position: relative;
    height: 40px;
    background: var(--bg-light);
    border: 3px solid var(--ink);
    overflow: hidden;
  }

  .hp-container.enemy { box-shadow: 6px 6px 0px var(--p2); transform: skewX(-10deg); }
  .hp-container.player { box-shadow: 6px 6px 0px var(--p1); transform: skewX(-10deg); }

  .hp-fill {
    height: 100%;
    transition: width 0.3s cubic-bezier(0.25, 1, 0.5, 1);
    position: absolute;
    top: 0; left: 0;
  }

  .hp-fill.player {
    background: repeating-linear-gradient(
      45deg,
      var(--p1),
      var(--p1) 10px,
      var(--p1-dark) 10px,
      var(--p1-dark) 20px
    );
  }

  .hp-fill.enemy {
    background: repeating-linear-gradient(
      45deg,
      var(--p2),
      var(--p2) 10px,
      var(--p2-dark) 10px,
      var(--p2-dark) 20px
    );
  }

  .hp-text {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'JetBrains Mono', monospace;
    font-size: 16px;
    font-weight: 800;
    color: var(--ink);
    z-index: 2;
    text-shadow: 1px 1px 0 rgba(255,255,255,0.5);
    transform: skewX(10deg);
  }

  .fighter-name {
    position: absolute;
    top: -25px;
    font-family: 'Archivo Black', sans-serif;
    font-size: 20px;
    letter-spacing: 1px;
    background: var(--ink);
    color: var(--bg-light);
    padding: 2px 12px;
    border: 2px solid var(--ink);
    transform: skewX(10deg);
  }
  
  .fighter-name.player { left: 0; }
  .fighter-name.enemy { right: 0; background: var(--p2-dark); }

  .vs-center {
    text-align: center;
    padding: 10px 20px;
    background: var(--ink);
    color: var(--accent);
    border: 3px solid var(--ink);
    clip-path: polygon(10% 0, 90% 0, 100% 50%, 90% 100%, 10% 100%, 0 50%);
    min-width: 120px;
  }

  .round-num {
    font-family: 'Archivo Black', sans-serif;
    font-size: 32px;
    line-height: 1;
  }

  .round-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    letter-spacing: 2px;
    color: var(--bg-light);
  }

  .arena-wrap {
    flex: 1;
    position: relative;
    background: var(--bg-light);
    border: 3px solid var(--ink);
    box-shadow: 8px 8px 0px var(--ink);
    overflow: hidden;
    min-height: 280px;
  }

  #arena {
    display: block;
    width: 100%;
    height: 100%;
  }

  .arena-overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .combo-display {
    position: absolute;
    top: 20px; left: 50%;
    transform: translateX(-50%);
    text-align: center;
    opacity: 0;
    transition: opacity 0.2s;
  }

  .combo-display.active { opacity: 1; }

  .combo-display .combo-num {
    font-family: 'Archivo Black', sans-serif;
    font-size: 64px;
    color: var(--accent);
    -webkit-text-stroke: 3px var(--ink);
    line-height: 1;
    animation: comboHit 0.2s ease;
  }

  @keyframes comboHit {
    0% { transform: scale(1.5) rotate(-5deg); }
    100% { transform: scale(1) rotate(0); }
  }

  .combo-display .combo-label {
    font-family: 'Archivo Black', sans-serif;
    font-size: 16px;
    color: var(--ink);
    letter-spacing: 2px;
    margin-top: -5px;
  }

  .key-prompt {
    position: absolute;
    bottom: 20px; left: 50%;
    transform: translateX(-50%);
    text-align: center;
    display: none; 
  }

  .key-prompt .key-letter {
    display: inline-block;
    font-family: 'Archivo Black', sans-serif;
    font-size: 80px;
    color: var(--ink);
    background: var(--accent);
    padding: 0 30px;
    border: 4px solid var(--ink);
    box-shadow: 8px 8px 0px var(--ink);
    line-height: 1.1;
    animation: keyAppear 0.2s ease;
  }

  @keyframes keyAppear {
    0% { transform: scale(0.5) rotate(10deg); opacity: 0; }
    100% { transform: scale(1) rotate(0); opacity: 1; }
  }

  .key-prompt .key-timer {
    width: 240px;
    height: 10px;
    background: var(--ink);
    margin: 16px auto 0;
    border: 2px solid var(--ink);
    overflow: hidden;
    transform: skewX(-20deg);
  }

  .key-timer-fill {
    height: 100%;
    background: var(--p1);
    width: 100%;
    transform-origin: left;
  }

  .hud-bottom {
    display: flex;
    flex-direction: column;
    gap: 15px;
  }

  .keyboard-wrap {
    background: var(--bg-light);
    border: 3px solid var(--ink);
    box-shadow: 6px 6px 0px var(--ink);
    padding: 15px;
  }

  .keyboard {
    display: flex;
    flex-direction: column;
    gap: 6px;
    align-items: center;
  }

  .kb-row {
    display: flex;
    gap: 6px;
  }

  .kb-key {
    width: 42px; height: 42px;
    background: var(--panel);
    border: 2px solid var(--ink);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'JetBrains Mono', monospace;
    font-size: 16px;
    font-weight: 800;
    color: var(--ink);
    transition: all 0.1s ease;
    box-shadow: 3px 3px 0px var(--ink);
    cursor: pointer;
  }

  .kb-key:active { transform: translate(2px, 2px); box-shadow: 0 0 0 var(--ink); }

  .kb-key.target {
    background: var(--accent);
    color: var(--ink);
    animation: targetPulse 0.4s infinite alternate;
  }

  @keyframes targetPulse {
    from { box-shadow: 3px 3px 0px var(--ink); }
    to { box-shadow: 3px 3px 0px var(--ink), 0 0 15px var(--accent); }
  }

  .kb-key.correct {
    background: var(--p1);
    color: var(--ink);
    transform: translate(3px, 3px);
    box-shadow: 0 0 0 var(--ink);
  }

  .kb-key.wrong {
    background: var(--p2);
    color: var(--bg-light);
    animation: wrongShake 0.2s ease;
  }

  @keyframes wrongShake {
    0%, 100% { transform: translateX(0); }
    25% { transform: translateX(-4px); }
    75% { transform: translateX(4px); }
  }

  .control-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    background: var(--ink);
    padding: 10px 20px;
    border: 3px solid var(--ink);
    box-shadow: 6px 6px 0px var(--p2);
  }

  .control-btn {
    padding: 8px 20px;
    background: var(--bg-light);
    border: 2px solid var(--bg-light);
    color: var(--ink);
    font-family: 'Archivo Black', sans-serif;
    font-size: 16px;
    cursor: pointer;
    transition: all 0.15s;
  }

  .control-btn:hover { background: var(--accent); border-color: var(--accent); }

  .stats-mini {
    display: flex;
    gap: 25px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 14px;
    color: var(--bg-light);
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .stats-mini span {
    color: var(--accent);
    font-weight: 800;
    margin-left: 8px;
  }

  /* === Pantalla de Fin (Optimizada para NO tener scroll) === */
  #gameover {
    align-items: center;
    justify-content: flex-start;
    padding: 20px;
    overflow: hidden;
  }

  .gameover-content {
    max-width: 900px;
    width: 100%;
    text-align: center;
    animation: fadeIn 0.6s ease;
    display: flex;
    flex-direction: column;
    gap: 20px;
    height: 100%;
    justify-content: center;
  }

  .gameover-title {
    font-family: 'Archivo Black', sans-serif;
    font-size: clamp(40px, 7vw, 90px);
    line-height: 1.1;
    letter-spacing: 0px;
    display: inline-block;
    padding: 15px 30px;
    border: 4px solid var(--ink);
    box-shadow: 12px 12px 0px var(--ink);
    max-width: 95vw;
    text-align: center;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
    margin: 0 auto;
  }

  .gameover-title.victory {
    background: var(--p1);
    color: var(--ink);
    box-shadow: 12px 12px 0px var(--accent);
  }

  .gameover-title.defeat {
    background: var(--p2);
    color: var(--bg-light);
    box-shadow: 12px 12px 0px var(--ink);
  }

  .gameover-subtitle {
    font-family: 'Archivo Black', sans-serif;
    font-size: 20px;
    letter-spacing: 2px;
    text-transform: uppercase;
    max-width: 800px;
    margin: 0 auto;
    line-height: 1.3;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 15px;
  }

  .stat-card {
    padding: 15px;
    background: var(--bg-light);
    border: 3px solid var(--ink);
    box-shadow: 6px 6px 0px var(--ink);
    text-align: center;
  }

  .stat-card .stat-val {
    font-family: 'Archivo Black', sans-serif;
    font-size: 40px;
    color: var(--ink);
    line-height: 1;
  }

  .stat-card .stat-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    color: var(--ink-soft);
    letter-spacing: 1px;
    text-transform: uppercase;
    margin-top: 6px;
  }

  .heatmap-section {
    background: var(--bg-light);
    border: 3px solid var(--ink);
    box-shadow: 6px 6px 0px var(--ink);
    padding: 20px;
    text-align: center;
  }

  .heatmap-title {
    font-family: 'Archivo Black', sans-serif;
    font-size: 26px;
    margin-bottom: 5px;
    text-transform: uppercase;
  }

  .heatmap-desc {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    color: var(--ink-soft);
    margin-bottom: 15px;
    text-transform: uppercase;
  }

  .heatmap-keyboard {
    display: flex;
    flex-direction: column;
    gap: 6px;
    align-items: center;
  }

  .hm-key {
    width: 42px; height: 42px;
    border: 2px solid var(--ink);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'JetBrains Mono', monospace;
    font-size: 16px;
    font-weight: 800;
    color: var(--ink);
    position: relative;
    box-shadow: 3px 3px 0px var(--ink);
  }

  .hm-key.unused { background: var(--panel); color: #ccc; }
  .hm-key.mastered { background: var(--p1); }
  .hm-key.good { background: #80ff80; }
  .hm-key.average { background: var(--accent); }
  .hm-key.poor { background: var(--p2); color: var(--bg-light); }
  .hm-key.critical { background: var(--ink); color: var(--p2); animation: critPulse 1s infinite; }

  @keyframes critPulse {
    0%, 100% { box-shadow: 3px 3px 0px var(--ink); }
    50% { box-shadow: 3px 3px 0px var(--ink), 0 0 15px var(--p2); }
  }

  .hm-key .hm-stat {
    position: absolute;
    bottom: 2px; right: 4px;
    font-size: 9px;
    opacity: 0.7;
  }

  .legend {
    display: flex;
    justify-content: center;
    gap: 15px;
    margin-top: 15px;
    flex-wrap: wrap;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    text-transform: uppercase;
  }

  .gameover-buttons {
    display: flex;
    gap: 15px;
    justify-content: center;
  }

  .gameover-buttons button {
    padding: 12px 30px;
    font-family: 'Archivo Black', sans-serif;
    font-size: 20px;
    cursor: pointer;
    border: 3px solid var(--ink);
    transition: all 0.2s;
    box-shadow: 6px 6px 0px var(--ink);
  }

  .gameover-buttons .primary { background: var(--p1); color: var(--ink); }
  .gameover-buttons .secondary { background: var(--bg-light); color: var(--ink); }

  .gameover-buttons button:hover {
    transform: translate(-2px, -2px);
    box-shadow: 8px 8px 0px var(--ink);
  }

  .toast {
    position: fixed;
    top: 30px; left: 50%;
    transform: translateX(-50%) translateY(-100px);
    padding: 15px 30px;
    background: var(--ink);
    color: var(--accent);
    font-family: 'Archivo Black', sans-serif;
    letter-spacing: 2px;
    z-index: 1000;
    transition: transform 0.3s ease;
    border: 3px solid var(--ink);
    box-shadow: 6px 6px 0px var(--p2);
  }

  .toast.show { transform: translateX(-50%) translateY(0); }

  @media (max-width: 768px) {
    .difficulty-row { grid-template-columns: repeat(2, 1fr); }
    /* Ajuste de teclas para móviles en el juego */
    .kb-row { gap: 4px; }
    .kb-key { width: 28px; height: 28px; font-size: 11px; box-shadow: 2px 2px 0px var(--ink); }
    .key-prompt .key-letter { font-size: 60px; }
    .hud-top { grid-template-columns: 1fr; }
    .vs-center { display: none; }
    
    /* Ajustes FINOS para que el menú de fin entre sin scroll */
    #gameover { padding: 10px; justify-content: flex-start; }
    .gameover-content { gap: 12px; justify-content: flex-start; padding-top: 5px; }
    .gameover-title { font-size: clamp(26px, 8vw, 40px); padding: 8px 15px; box-shadow: 6px 6px 0px var(--ink); border-width: 3px; }
    .gameover-subtitle { font-size: 12px; letter-spacing: 1px; line-height: 1.2; }
    
    .stats-grid { grid-template-columns: repeat(2, 1fr); gap: 10px; }
    .stat-card { padding: 10px; box-shadow: 4px 4px 0px var(--ink); border-width: 2px; }
    .stat-card .stat-val { font-size: 28px; }
    .stat-card .stat-label { font-size: 10px; margin-top: 4px; }
    
    .heatmap-section { padding: 12px; box-shadow: 4px 4px 0px var(--ink); border-width: 2px; }
    .heatmap-title { font-size: 20px; margin-bottom: 2px; }
    .heatmap-desc { font-size: 10px; margin-bottom: 10px; }
    .hm-key { width: 26px; height: 26px; font-size: 10px; box-shadow: 2px 2px 0px var(--ink); border-width: 1px; }
    .heatmap-keyboard { gap: 3px; }
    .hm-key .hm-stat { font-size: 8px; }
    .legend { font-size: 9px; gap: 8px; margin-top: 10px; }
    
    .gameover-buttons { gap: 10px; flex-wrap: wrap; }
    .gameover-buttons button { padding: 10px 20px; font-size: 16px; box-shadow: 4px 4px 0px var(--ink); border-width: 2px; flex: 1; }
  }
</style>
</head>
<body>
<div id="app">
  <section id="menu" class="screen active">
    <div class="menu-content">
      <div class="menu-watermark">LUCHA</div>
      <div class="title-block">
        <h1>GUERRERO<br>DEL TECLADO</h1>
      </div>
      <div class="subtitle">EDICIÓN COMBATE</div>

      <div class="instructions">
        <ul>
