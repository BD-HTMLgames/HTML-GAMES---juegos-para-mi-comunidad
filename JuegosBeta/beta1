</div>

<script>
// =================================================================
// CONFIGURACIÓN DEL JUEGO
// =================================================================
const DIFFICULTIES = {
  tutorial:      { isTutorial: true, sequence: ['E','N','T','R','E','N','A','M','I','E','N','T','O'], timeLimit: 4000, playerDmg: 20, enemyDmg: 10, enemyName: 'MANIQUÍ DE ENTRENAMIENTO', enemyHp: 200, playerHp: 100, delay: 600 },
  principiante: { isTutorial: false, timeLimit: 3000, pool: 'QWERTYUIOPASDFGHJKLZXCVBNM', playerDmg: 10, enemyDmg: 8, enemyName: 'BOT NOVATO', enemyHp: 300, playerHp: 300, delay: 800 },
  avanzado:     { isTutorial: false, timeLimit: 2200, pool: 'QWERTYUIOPASDFGHJKLZXCVBNM1234567890', playerDmg: 12, enemyDmg: 12, enemyName: 'BOT AVANZADO', enemyHp: 400, playerHp: 400, delay: 600 },
  experto:      { isTutorial: false, timeLimit: 1500, pool: 'QWERTYUIOPASDFGHJKLZXCVBNM1234567890', playerDmg: 15, enemyDmg: 15, enemyName: 'BOT EXPERTO', enemyHp: 500, playerHp: 500, delay: 400 }
};

const KEYBOARD_LAYOUT = [
  ['1','2','3','4','5','6','7','8','9','0'],
  ['Q','W','E','R','T','Y','U','I','O','P'],
  ['A','S','D','F','G','H','J','K','L','Ñ'],
  ['Z','X','C','V','B','N','M',',','.','-']
];

const state = {
  difficulty: 'tutorial',
  config: null,
  matchId: 0,
  tutorialIndex: 0, 
  player: { hp: 200, maxHp: 200 },
  enemy: { hp: 200, maxHp: 200, name: 'ENEMIGO' },
  current: null,
  timeStart: 0,
  timeLimit: 4000,
  score: 0,
  combo: 0,
  maxCombo: 0,
  correct: 0,
  wrong: 0,
  totalAttempts: 0,
  round: 1,
  playing: false,
  paused: false,
  startTime: 0,
  keyStats: {},
  particles: [],
  floats: [],
  shake: 0,
  playerPose: 'idle',
  enemyPose: 'idle',
  playerAnim: null,
  enemyAnim: null
};

const MAX_PARTICLES = 80;
let activeTimeouts = [];

function setSafeTimeout(callback, delay) {
  const id = setTimeout(() => {
    activeTimeouts = activeTimeouts.filter(t => t !== id);
    callback(state.matchId);
  }, delay);
  activeTimeouts.push(id);
  return id;
}

function clearAllTimeouts() {
  activeTimeouts.forEach(id => clearTimeout(id));
  activeTimeouts = [];
}

let audioCtx = null;
function initAudio() {
  if (!audioCtx) {
    try { audioCtx = new (window.AudioContext || window.webkitAudioContext)(); } catch(e) {}
  }
}

function playTone(freq, duration, type='square', vol=0.15, slide=null) {
  if (!audioCtx) return;
  const osc = audioCtx.createOscillator();
  const gain = audioCtx.createGain();
  osc.type = type;
  osc.frequency.setValueAtTime(freq, audioCtx.currentTime);
  if (slide) osc.frequency.exponentialRampToValueAtTime(slide, audioCtx.currentTime + duration);
  gain.gain.setValueAtTime(vol, audioCtx.currentTime);
  gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + duration);
  osc.connect(gain).connect(audioCtx.destination);
  osc.start();
  osc.stop(audioCtx.currentTime + duration);
}

const sfx = {
  hit: () => { playTone(200, 0.1, 'square', 0.2, 80); },
  miss: () => { playTone(120, 0.2, 'sawtooth', 0.18, 50); },
  correct: () => { playTone(880, 0.05, 'square', 0.1, 1320); },
  combo: (n) => { playTone(440 + n*40, 0.08, 'square', 0.15, 880 + n*40); },
  ko: () => { playTone(300, 0.5, 'sawtooth', 0.25, 40); },
  win: () => { [523, 659, 784, 1047].forEach((f,i) => setSafeTimeout(() => playTone(f, 0.15, 'square', 0.15), i*80)); }
};

function $(id) { return document.getElementById(id); }
function rand(min, max) { return Math.random() * (max - min) + min; }
function clamp(v, min, max) { return Math.max(min, Math.min(max, v)); }
function lerp(a, b, t) { return a + (b - a) * t; }

function showToast(msg, duration=2000) {
  const t = $('toast');
  t.textContent = msg;
  t.classList.add('show');
  clearTimeout(t._timer);
  t._timer = setTimeout(() => t.classList.remove('show'), duration);
}

const POSES = {
  idle: { head: [0, -70], neck: [0, -58], chest: [0, -35], hip: [0, 0], shoulderL: [-14, -48], shoulderR: [14, -48], elbowL: [-22, -28], elbowR: [22, -28], handL: [-26, -8], handR: [26, -8], kneeL: [-9, 32], kneeR: [9, 32], footL: [-14, 65], footR: [14, 65] },
  attack: { head: [3, -70], neck: [3, -58], chest: [6, -35], hip: [0, 0], shoulderL: [-12, -48], shoulderR: [16, -48], elbowL: [-18, -38], elbowR: [30, -42], handL: [-15, -42], handR: [55, -38], kneeL: [-12, 32], kneeR: [12, 30], footL: [-16, 65], footR: [16, 65] },
  hit: { head: [-12, -65], neck: [-8, -55], chest: [-5, -35], hip: [0, 0], shoulderL: [-18, -46], shoulderR: [10, -46], elbowL: [-28, -30], elbowR: [18, -22], handL: [-35, -12], handR: [22, 4], kneeL: [-14, 30], kneeR: [8, 34], footL: [-18, 65], footR: [12, 65] },
  block: { head: [2, -70], neck: [2, -58], chest: [3, -35], hip: [0, 0], shoulderL: [-10, -48], shoulderR: [14, -48], elbowL: [-4, -42], elbowR: [18, -42], handL: [4, -52], handR: [22, -52], kneeL: [-10, 32], kneeR: [10, 32], footL: [-15, 65], footR: [15, 65] },
  ko: { head: [-30, -10], neck: [-20, -8], chest: [-10, -5], hip: [0, 0], shoulderL: [-12, -10], shoulderR: [8, -2], elbowL: [-22, 5], elbowR: [18, 10], handL: [-30, 18], handR: [25, 20], kneeL: [-8, 30], kneeR: [10, 28], footL: [-12, 62], footR: [16, 60] },
  victory: { head: [0, -75], neck: [0, -63], chest: [0, -38], hip: [0, 0], shoulderL: [-14, -52], shoulderR: [14, -52], elbowL: [-22, -68], elbowR: [22, -68], handL: [-26, -82], handR: [26, -82], kneeL: [-9, 32], kneeR: [9, 32], footL: [-14, 65], footR: [14, 65] }
};

function lerpPose(a, b, t) {
  const result = {};
  for (let key in a) result[key] = [lerp(a[key][0], b[key][0], t), lerp(a[key][1], b[key][1], t)];
  return result;
}

let canvas, ctx;
let cw = 0, ch = 0;

function initCanvas() {
  canvas = $('arena');
  ctx = canvas.getContext('2d');
  resizeCanvas();
  window.addEventListener('resize', resizeCanvas);
}

function resizeCanvas() {
  const rect = canvas.getBoundingClientRect();
  const dpr = window.devicePixelRatio || 1;
  canvas.width = rect.width * dpr;
  canvas.height = rect.height * dpr;
  ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  cw = rect.width;
  ch = rect.height;
}

function drawStickman(x, y, pose, color, facing, auraColor) {
  const p = pose;
  ctx.save();
  ctx.translate(x, y);
  if (facing === 'left') ctx.scale(-1, 1);

  ctx.fillStyle = 'rgba(10, 10, 10, 0.3)';
  ctx.fillRect(-30, 66, 60, 6);

  ctx.strokeStyle = color;
  ctx.fillStyle = color;
  ctx.lineWidth = 7;
  ctx.lineCap = 'square';
  ctx.lineJoin = 'miter';

  ctx.beginPath();
  ctx.moveTo(p.neck[0], p.neck[1]);
  ctx.lineTo(p.hip[0], p.hip[1]);
  ctx.moveTo(p.shoulderL[0], p.shoulderL[1]);
  ctx.lineTo(p.elbowL[0], p.elbowL[1]);
  ctx.lineTo(p.handL[0], p.handL[1]);
  ctx.moveTo(p.shoulderR[0], p.shoulderR[1]);
  ctx.lineTo(p.elbowR[0], p.elbowR[1]);
  ctx.lineTo(p.handR[0], p.handR[1]);
  ctx.moveTo(p.hip[0], p.hip[1]);
  ctx.lineTo(p.kneeL[0], p.kneeL[1]);
  ctx.lineTo(p.footL[0], p.footL[1]);
  ctx.moveTo(p.hip[0], p.hip[1]);
  ctx.lineTo(p.kneeR[0], p.kneeR[1]);
  ctx.lineTo(p.footR[0], p.footR[1]);
  ctx.stroke();

  ctx.beginPath();
  ctx.arc(p.head[0], p.head[1], 13, 0, Math.PI * 2);
  ctx.fill();
  
  ctx.strokeStyle = '#0a0a0a';
  ctx.lineWidth = 2;
  ctx.beginPath();
  ctx.moveTo(p.head[0] + 5, p.head[1] - 2);
  ctx.lineTo(p.head[0] + 10, p.head[1] - 2);
  ctx.stroke();

  if (auraColor) {
    ctx.strokeStyle = auraColor;
    ctx.lineWidth = 3;
    ctx.globalAlpha = 0.6;
    ctx.beginPath();
    ctx.moveTo(p.neck[0], p.neck[1]);
    ctx.lineTo(p.hip[0], p.hip[1]);
    ctx.moveTo(p.shoulderL[0], p.shoulderL[1]);
    ctx.lineTo(p.elbowL[0], p.elbowL[1]);
    ctx.lineTo(p.handL[0], p.handL[1]);
    ctx.moveTo(p.shoulderR[0], p.shoulderR[1]);
    ctx.lineTo(p.elbowR[0], p.elbowR[1]);
    ctx.lineTo(p.handR[0], p.handR[1]);
    ctx.moveTo(p.hip[0], p.hip[1]);
    ctx.lineTo(p.kneeL[0], p.kneeL[1]);
    ctx.lineTo(p.footL[0], p.footL[1]);
    ctx.moveTo(p.hip[0], p.hip[1]);
    ctx.lineTo(p.kneeR[0], p.kneeR[1]);
    ctx.lineTo(p.footR[0], p.footR[1]);
    ctx.stroke();
    ctx.globalAlpha = 1;
  }

  ctx.restore();
}

function drawArena() {
  ctx.clearRect(0, 0, cw, ch);

  let shakeX = 0, shakeY = 0;
  if (state.shake > 0) {
    shakeX = (Math.random() - 0.5) * state.shake;
    shakeY = (Math.random() - 0.5) * state.shake;
    state.shake *= 0.85;
    if (state.shake < 0.3) state.shake = 0;
  }
  ctx.save();
  ctx.translate(shakeX, shakeY);

  const groundY = ch * 0.78;
  ctx.fillStyle = '#e6e6e6';
  ctx.fillRect(0, groundY, cw, ch - groundY);
  
  ctx.strokeStyle = '#0a0a0a';
  ctx.lineWidth = 4;
  ctx.beginPath();
  ctx.moveTo(0, groundY);
  ctx.lineTo(cw, groundY);
  ctx.stroke();

  ctx.lineWidth = 1;
  ctx.beginPath();
  for(let i=1; i<5; i++) {
    ctx.moveTo(0, groundY + i*15);
    ctx.lineTo(cw, groundY + i*15);
  }
  ctx.stroke();

  ctx.strokeStyle = 'rgba(10, 10, 10, 0.8)';
  ctx.lineWidth = 3;
  ctx.beginPath();
  ctx.ellipse(cw/2, groundY, cw*0.4, 20, 0, 0, Math.PI * 2);
  ctx.stroke();
  ctx.strokeStyle = 'rgba(255, 59, 48, 0.5)';
  ctx.lineWidth = 8;
  ctx.beginPath();
  ctx.ellipse(cw/2, groundY, cw*0.35, 16, 0, 0, Math.PI * 2);
  ctx.stroke();

  const playerX = cw * 0.32;
  const enemyX = cw * 0.68;
  const fighterY = groundY - 65;

  const playerPose = getCurrentPose('player');
  const enemyPose = getCurrentPose('enemy');

  if (state.current && state.playing && !state.paused) {
    const pulse = 1 + Math.sin(performance.now() * 0.01) * 0.1;
    ctx.save();
    ctx.translate(playerX, fighterY - 110);
    ctx.scale(pulse, pulse);

    ctx.fillStyle = '#0a0a0a';
    ctx.beginPath();
    ctx.moveTo(-25, -25); ctx.lineTo(25, -25);
    ctx.lineTo(20, 25); ctx.lineTo(-20, 25);
    ctx.closePath(); ctx.fill();

    const elapsed = performance.now() - state.timeStart;
    const progress = clamp(1 - elapsed / state.timeLimit, 0, 1);
    ctx.strokeStyle = progress > 0.3 ? '#00b3ff' : '#ff3b30';
    ctx.lineWidth = 6;
    ctx.lineCap = 'square';
    ctx.beginPath();
    ctx.arc(0, 0, 32, -Math.PI/2, -Math.PI/2 + progress * Math.PI * 2);
    ctx.stroke();

    ctx.fillStyle = '#ffd60a';
    ctx.font = 'bold 32px "Archivo Black", sans-serif';
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    ctx.fillText(state.current, 0, 0);
    ctx.restore();
  }

  drawStickman(playerX, fighterY, playerPose, '#0a0a0a', 'right', state.current ? '#00b3ff' : null);
  drawStickman(enemyX, fighterY, enemyPose, '#0a0a0a', 'left', state.enemyPose === 'attack' ? '#ff3b30' : null);

  drawParticles();
  drawFloats();

  ctx.restore();
}

function getCurrentPose(who) {
  const current = who === 'player' ? state.playerPose : state.enemyPose;
  const anim = who === 'player' ? state.playerAnim : state.enemyAnim;
  if (!anim) return POSES[current] || POSES.idle;
  const elapsed = performance.now() - anim.start;
  const t = clamp(elapsed / anim.duration, 0, 1);
  return lerpPose(POSES[anim.from], POSES[anim.to], t);
}

function setPose(who, pose, duration=200) {
  const currentPose = who === 'player' ? state.playerPose : state.enemyPose;
  if (currentPose === pose) return;
  const anim = { from: currentPose, to: pose, start: performance.now(), duration: duration };
  if (who === 'player') { state.playerAnim = anim; state.playerPose = pose; }
  else { state.enemyAnim = anim; state.enemyPose = pose; }

  if (pose !== 'idle' && pose !== 'ko' && pose !== 'victory') {
    setSafeTimeout(() => {
      if (who === 'player' && state.playerPose === pose) setPose('player', 'idle', 200);
      else if (who === 'enemy' && state.enemyPose === pose) setPose('enemy', 'idle', 200);
    }, duration);
  }
}

function spawnHitParticles(x, y, color, count=12) {
  const allowed = Math.min(count, MAX_PARTICLES - state.particles.length);
  for (let i = 0; i < allowed; i++) {
    const angle = Math.random() * Math.PI * 2;
    const speed = rand(2, 8);
    state.particles.push({
      x, y,
      vx: Math.cos(angle) * speed,
      vy: Math.sin(angle) * speed - 3,
      life: 1,
      decay: rand(0.03, 0.06),
      size: rand(3, 6),
      color
    });
  }
}

function drawParticles() {
  for (let i = state.particles.length - 1; i >= 0; i--) {
    const p = state.particles[i];
    p.x += p.vx;
    p.y += p.vy;
    p.vy += 0.3; 
    p.vx *= 0.95;
    p.life -= p.decay;

    if (p.life <= 0) { state.particles.splice(i, 1); continue; }

    ctx.globalAlpha = p.life;
    ctx.fillStyle = p.color;
    ctx.fillRect(p.x - p.size/2, p.y - p.size/2, p.size, p.size);
  }
  ctx.globalAlpha = 1;
}

function spawnFloat(x, y, text, color) {
  state.floats.push({ x, y, text, color, life: 1, vy: -2 });
}

function drawFloats() {
  ctx.textAlign = 'center';
  for (let i = state.floats.length - 1; i >= 0; i--) {
    const f = state.floats[i];
    f.y += f.vy;
    f.life -= 0.02;
    if (f.life <= 0) { state.floats.splice(i, 1); continue; }
    
    ctx.globalAlpha = f.life;
    ctx.font = 'bold 32px "Archivo Black", sans-serif';
    ctx.fillStyle = '#0a0a0a';
    ctx.fillText(f.text, f.x + 3, f.y + 3);
    ctx.fillStyle = f.color;
    ctx.fillText(f.text, f.x, f.y);
  }
  ctx.globalAlpha = 1;
}

function startGame() {
  clearAllTimeouts();
  state.matchId = (state.matchId || 0) + 1;
  const currentMatch = state.matchId;

  initAudio();
  state.config = DIFFICULTIES[state.difficulty];
  state.tutorialIndex = 0; 
  
  state.player.hp = state.config.playerHp;
  state.player.maxHp = state.config.playerHp;
  state.enemy.hp = state.config.enemyHp;
  state.enemy.maxHp = state.config.enemyHp;
  state.enemy.name = state.config.enemyName;
  state.score = 0;
  state.combo = 0;
  state.maxCombo = 0;
  state.correct = 0;
  state.wrong = 0;
  state.totalAttempts = 0;
  state.round = 1;
  state.keyStats = {};
  state.particles = [];
  state.floats = [];
  state.playing = true;
  state.paused = false;
  state.current = null; 
  state.startTime = performance.now();

  $('enemyName').textContent = state.enemy.name;
  
  if (state.config.isTutorial) {
    showToast('TUTORIAL: Deletrea "ENTRENAMIENTO". Cuidado con fallar.');
  }

  updateHUD();
  buildKeyboard();
  showScreen('game');
  setPose('player', 'idle');
  setPose('enemy', 'idle');

  setSafeTimeout((mId) => { 
    if (state.playing && state.matchId === mId) nextKey(); 
  }, 1000);
}

function nextKey() {
  if (!state.playing || state.paused) return;
  if (state.player.hp <= 0 || state.enemy.hp <= 0) { endGame(); return; }

  let key;
  if (state.config.isTutorial) {
    key = state.config.sequence[state.tutorialIndex];
  } else {
    do { 
      key = state.config.pool[Math.floor(Math.random() * state.config.pool.length)]; 
    } while (key === state.current && state.config.pool.length > 1);
  }

  state.current = key;
  state.timeStart = performance.now();
  state.timeLimit = state.config.timeLimit;

  if (!state.keyStats[key]) state.keyStats[key] = { attempts: 0, correct: 0, totalTime: 0 };
  state.keyStats[key].attempts++;

  showKeyPrompt(key);
  
  if (state.config.isTutorial) {
    highlightKeyboardKey(key, 'target');
  }
}

function showKeyPrompt(key) {
  if (state.config.isTutorial) {
    $('keyLetter').textContent = key;
    $('keyPrompt').style.display = 'block';
    $('keyTimerFill').style.transition = 'none';
    $('keyTimerFill').style.transform = 'scaleX(1)';
    $('keyTimerFill').offsetWidth; 
    $('keyTimerFill').style.transition = `transform ${state.timeLimit}ms linear`;
    $('keyTimerFill').style.transform = 'scaleX(0)';
  } else {
    $('keyPrompt').style.display = 'none';
  }
}

function hideKeyPrompt() { 
  $('keyPrompt').style.display = 'none'; 
}

function handleKey(key) {
  if (!state.playing || state.paused || !state.current) return;
  key = key.toUpperCase();
  if (key === 'Ñ' || key === ';') key = 'Ñ';

  if (key === state.current) onCorrect(performance.now() - state.timeStart);
  else if (KEYBOARD_LAYOUT.flat().includes(key) || /[A-Z0-9]/.test(key)) onWrong(key);
}

function onCorrect(elapsedMs) {
  if (!state.playing || !state.current) return;
  const correctKey = state.current;
  state.current = null; 
  hideKeyPrompt();

  state.correct++;
  state.totalAttempts++;
  state.combo++;
  state.maxCombo = Math.max(state.maxCombo, state.combo);

  const ks = state.keyStats[correctKey];
  ks.correct++;
  ks.totalTime += elapsedMs;

  const speedRatio = clamp(1 - (elapsedMs / state.timeLimit), 0, 1);
  const comboBonus = 1 + Math.min(state.combo * 0.05, 0.5);
  const dmg = Math.round(state.config.playerDmg * (0.5 + speedRatio) * comboBonus);
  
  state.enemy.hp = Math.max(0, state.enemy.hp - dmg);
  state.score += Math.round(100 * speedRatio * comboBonus);

  if (state.config.isTutorial) {
    state.tutorialIndex++;
    if (state.tutorialIndex >= state.config.sequence.length) {
      state.tutorialIndex = 0;
    }
  }

  setPose('player', 'attack', 180);
  setSafeTimeout(() => setPose('enemy', 'hit', 220), 150);
  state.shake = 10;

  const groundY = ch * 0.78;
  spawnHitParticles(cw * 0.68, groundY - 50, '#ff3b30', 15);
  
  spawnFloat(cw * 0.68, groundY - 80, `-${dmg}`, '#00b3ff');
  if (state.combo >= 3) {
    sfx.combo(state.combo);
  } else {
    sfx.correct();
  }
  sfx.hit();

  highlightKeyboardKey(correctKey, 'correct');
  setSafeTimeout(() => clearKeyboardHighlight(correctKey), 300);

  updateComboDisplay();
  updateHUD();

  setSafeTimeout((mId) => { if (state.playing && state.matchId === mId) nextKey(); }, state.config.delay);
}

function onWrong(pressedKey) {
  if (!state.playing || !state.current) return;
  const targetKey = state.current;
  state.current = null; 
  hideKeyPrompt();

  state.wrong++;
  state.totalAttempts++;
  state.combo = 0;

  const dmg = state.config.enemyDmg; 
  state.player.hp = Math.max(0, state.player.hp - dmg);

  setPose('enemy', 'attack', 200);
  setSafeTimeout(() => setPose('player', 'hit', 250), 180);
  state.shake = 12;

  const groundY = ch * 0.78;
  spawnHitParticles(cw * 0.32, groundY - 50, '#00b3ff', 12);
  spawnFloat(cw * 0.32, groundY - 80, `-${dmg}`, '#ff3b30');
  spawnFloat(cw/2, ch * 0.3, 'FALLO', '#ff3b30');

  sfx.miss();

  highlightKeyboardKey(pressedKey, 'wrong');
  setSafeTimeout(() => clearKeyboardHighlight(pressedKey), 300);
  clearKeyboardHighlight(targetKey);

  updateHUD();
  updateComboDisplay();

  setSafeTimeout((mId) => { if (state.playing && state.matchId === mId) nextKey(); }, state.config.delay);
}

function onTimeout() {
  if (!state.playing || !state.current) return;
  const timedOutKey = state.current;
  state.current = null; 
  hideKeyPrompt();

  state.wrong++;
  state.totalAttempts++;
  state.combo = 0;

  const dmg = Math.round(state.config.enemyDmg * 1.2); 
  state.player.hp = Math.max(0, state.player.hp - dmg);

  setPose('enemy', 'attack', 240);
  setSafeTimeout(() => setPose('player', 'hit', 300), 200);
  state.shake = 15;

  const groundY = ch * 0.78;
  spawnHitParticles(cw * 0.32, groundY - 50, '#00b3ff', 15);
  spawnFloat(cw * 0.32, groundY - 80, `-${dmg}`, '#ff3b30');
  spawnFloat(cw/2, ch * 0.3, 'SIN TIEMPO', '#ff3b30');

  sfx.miss();
  clearKeyboardHighlight(timedOutKey);
  updateHUD();
  updateComboDisplay();

  setSafeTimeout((mId) => { if (state.playing && state.matchId === mId) nextKey(); }, state.config.delay);
}

function endGame() {
  if (!state.playing) return;
  state.playing = false;
  state.current = null;
  const victory = state.enemy.hp <= 0;

  if (victory) {
    setPose('player', 'victory', 400);
    setPose('enemy', 'ko', 400);
    sfx.win();
  } else {
    setPose('player', 'ko', 400);
    setPose('enemy', 'victory', 400);
    sfx.ko();
  }

  const accuracy = state.totalAttempts > 0 ? Math.round((state.correct / state.totalAttempts) * 100) : 0;
  const elapsedMin = (performance.now() - state.startTime) / 60000;
  const wpm = elapsedMin > 0 ? Math.round(state.correct / elapsedMin) : 0;

  if (state.config.isTutorial) {
    if (victory) {
      $('gameoverTitle').innerHTML = 'ENTRENAMIENTO COMPLETADO';
      $('gameoverTitle').className = 'gameover-title victory';
      $('gameoverSubtitle').textContent = 'HAS DOMINADO LA BASE. ¡PRUEBA EL MODO PRINCIPIANTE!';
    } else {
      $('gameoverTitle').innerHTML = 'VUELVE A INTENTARLO';
      $('gameoverTitle').className = 'gameover-title defeat';
      $('gameoverSubtitle').textContent = 'TE HAS QUEDADO SIN VIDA. ¡CONCÉNTRATE Y REPITE!';
    }
  } else {
    $('gameoverTitle').textContent = victory ? 'VICTORIA' : 'DERROTA';
    $('gameoverTitle').className = 'gameover-title ' + (victory ? 'victory' : 'defeat');
    $('gameoverSubtitle').textContent = 'EL COMBATE HA TERMINADO';
  }
  
  $('finalScore').textContent = state.score.toLocaleString();
  $('finalAccuracy').textContent = accuracy + '%';
  $('finalCombo').textContent = state.maxCombo;
  $('finalWpm').textContent = wpm;

  buildHeatmap();
  setSafeTimeout(() => showScreen('gameover'), 1500);
}

function buildHeatmap() {
  const container = $('heatmapKeyboard');
  container.innerHTML = '';
  KEYBOARD_LAYOUT.forEach(row => {
    const rowEl = document.createElement('div');
    rowEl.className = 'kb-row';
    row.forEach(key => {
      const k = document.createElement('div');
      k.className = 'hm-key';
      const stats = state.keyStats[key];
      if (!stats || stats.attempts === 0) {
        k.classList.add('unused');
        k.textContent = key;
      } else {
        const accuracy = stats.correct / stats.attempts;
        if (accuracy >= 0.9) k.classList.add('mastered');
        else if (accuracy >= 0.7) k.classList.add('good');
        else if (accuracy >= 0.5) k.classList.add('average');
        else if (accuracy >= 0.3) k.classList.add('poor');
        else k.classList.add('critical');
        k.textContent = key;
        const stat = document.createElement('span');
        stat.className = 'hm-stat';
        stat.textContent = `${Math.round(accuracy*100)}%`;
        k.appendChild(stat);
      }
      rowEl.appendChild(k);
    });
    container.appendChild(rowEl);
  });
}

function updateHUD() {
  $('playerHp').style.width = (state.player.hp / state.player.maxHp * 100) + '%';
  $('enemyHp').style.width = (state.enemy.hp / state.enemy.maxHp * 100) + '%';
  $('playerHpText').textContent = `${state.player.hp} / ${state.player.maxHp}`;
  $('enemyHpText').textContent = `${state.enemy.hp} / ${state.enemy.maxHp}`;
  $('scoreVal').textContent = state.score.toLocaleString();
  $('correctVal').textContent = state.correct;
  $('wrongVal').textContent = state.wrong;
  const acc = state.totalAttempts > 0 ? Math.round((state.correct / state.totalAttempts) * 100) : 100;
  $('accuracyVal').textContent = acc + '%';
}

function updateComboDisplay() {
  const cd = $('comboDisplay');
  if (state.combo >= 2) {
    cd.classList.add('active');
    $('comboNum').textContent = `${state.combo} COMBO`;
    $('comboNum').style.animation = 'none';
    $('comboNum').offsetWidth;
    $('comboNum').style.animation = 'comboHit 0.2s ease';
  } else {
    cd.classList.remove('active');
  }
}

function buildKeyboard() {
  const kb = $('keyboard');
  kb.innerHTML = '';
  KEYBOARD_LAYOUT.forEach(row => {
    const rowEl = document.createElement('div');
    rowEl.className = 'kb-row';
    row.forEach(key => {
      const k = document.createElement('div');
      k.className = 'kb-key';
      k.textContent = key;
      k.dataset.key = key;
      rowEl.appendChild(k);
    });
    kb.appendChild(rowEl);
  });
}

function highlightKeyboardKey(key, type) {
  const k = document.querySelector(`.kb-key[data-key="${key}"]`);
  if (!k) return;
  k.classList.remove('correct', 'wrong', 'target');
  k.classList.add(type);
}

function clearKeyboardHighlight(key) {
  const k = document.querySelector(`.kb-key[data-key="${key}"]`);
  if (!k) return;
  k.classList.remove('correct', 'wrong', 'target');
}

function gameLoop() {
  if (state.playing && !state.paused && state.current) {
    const elapsed = performance.now() - state.timeStart;
    if (elapsed >= state.timeLimit) onTimeout();
  }
  drawArena();
  requestAnimationFrame(gameLoop);
}

function showScreen(name) {
  document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
  $(name).classList.add('active');
  if (name === 'game') setTimeout(resizeCanvas, 50);
}

function bindEvents() {
  document.querySelectorAll('.diff-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.diff-btn').forEach(b => b.classList.remove('selected'));
      btn.classList.add('selected');
      state.difficulty = btn.dataset.diff;
    });
  });

  $('startBtn').addEventListener('click', startGame);

  document.addEventListener('keydown', (e) => {
    if (state.paused && (e.key === 'Escape' || e.key === 'p' || e.key === 'P')) { togglePause(); return; }
    if (!state.playing) return;
    if (e.key.length === 1) { e.preventDefault(); handleKey(e.key); }
    if (e.key === 'Escape' || e.key === 'p' || e.key === 'P') togglePause();
  });

  $('pauseBtn').addEventListener('click', togglePause);
  $('quitBtn').addEventListener('click', () => { state.playing = false; clearAllTimeouts(); showScreen('menu'); });
  $('retryBtn').addEventListener('click', startGame);
  $('menuBtn').addEventListener('click', () => { clearAllTimeouts(); showScreen('menu'); });

  $('keyboard').addEventListener('click', (e) => {
    const k = e.target.closest('.kb-key');
    if (k && k.dataset.key) handleKey(k.dataset.key);
  });
}

function togglePause() {
  if (!state.playing) return;
  state.paused = !state.paused;
  $('pauseBtn').textContent = state.paused ? 'CONTINUAR' : 'PAUSA';
  if (state.paused) {
    showToast('JUEGO EN PAUSA');
    state.pauseTime = performance.now();
  } else {
    if (state.pauseTime) state.timeStart += performance.now() - state.pauseTime;
    showToast('CONTINÚA LA LUCHA');
  }
}

window.addEventListener('load', () => {
  initCanvas();
  bindEvents();
  requestAnimationFrame(gameLoop);
});
</script>
</body>
</html>
